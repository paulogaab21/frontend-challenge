# Base URL of the REST API. With mocks enabled, MSW intercepts this path in the browser.
VITE_API_URL=/api

# Origin of the Socket.IO server. Empty = same origin as the app.
VITE_SOCKET_URL=

# "true" boots the MSW layer (REST handlers + Socket.IO simulation) before the app renders.
# The delivered demo build keeps it enabled; set to "false" to target a real backend.
VITE_ENABLE_MOCKS=true

# Default mock scenario (see README > Cenários). Can be overridden at runtime.
VITE_MOCK_SCENARIO=default
